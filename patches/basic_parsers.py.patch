+    def _end_after_start_in(self, input_ids: Sequence[int]) -> bool:
+        """Return True only if end_token appears after start_token.
+
+        Non-virtual: uses a plain forward scan so subclass overrides of
+        ``is_reasoning_end`` (which may carry deferred/stateful semantics)
+        do not affect this check.
+        """
+        found_start = False
+        for token_id in input_ids:
+            if token_id == self.start_token_id:
+                found_start = True
+            elif token_id == self.end_token_id and found_start:
+                return True
+        return False
