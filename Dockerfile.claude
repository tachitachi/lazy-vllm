FROM ubuntu:24.04

# Core tools: Go, Node, Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git bash && \
    # Detect arch and install Go 1.26.2
    ARCH=$(dpkg --print-architecture | sed 's/amd64/amd64/; s/arm64/arm64/') && \
    curl -sL "https://dl.google.com/go/go1.26.2.linux-${ARCH}.tar.gz" | tar xz -C /usr/local && \
    # Node.js 24.x via nodesource
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y nodejs && \
    # Python 3
    apt-get install -y python3 python3-pip && \
    # Cleanup
    rm -rf /var/lib/apt/lists/*

# Accept any mounted directory for git (needed for bind-mounted workspaces)
RUN git config --global --add safe.directory '*'

# Install Claude Code via npm globally
RUN npm install -g @anthropic-ai/claude-code@2.1.143

# Install RTK to a system path so it persists across the /home/ubuntu volume mount
RUN curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/tags/v0.40.0/install.sh | RTK_INSTALL_DIR=/usr/local/bin sh

# ubuntu:24.04 ships with a 'ubuntu' user at UID/GID 1000 — reuse it
RUN mkdir -p /workspace && \
    chown ubuntu:ubuntu /workspace && \
    chmod -R 755 /root

ENV PATH="/usr/local/go/bin:/home/ubuntu/.npm-global/bin:$PATH"
ENV GOPATH="/home/ubuntu/go"

# Default working directory for mounted workspace
WORKDIR /workspace

# Switch to non-root user
USER ubuntu

COPY --chmod=755 scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["claude"]
