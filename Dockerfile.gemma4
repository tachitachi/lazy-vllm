FROM vllm/vllm-openai:gemma4-0505-cu130

COPY patches/gemma4_reasoning_parser.py /tmp/gemma4_reasoning_parser.py
COPY patches/basic_parsers.py /tmp/basic_parsers.py
RUN python3 -c "import shutil, vllm, os; base = os.path.dirname(vllm.__file__); shutil.copy('/tmp/gemma4_reasoning_parser.py', os.path.join(base, 'reasoning/gemma4_reasoning_parser.py')); shutil.copy('/tmp/basic_parsers.py', os.path.join(base, 'reasoning/basic_parsers.py'))"
